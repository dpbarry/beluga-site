% -*- mode: beluga; indent-tabs-mode: nil -*-
% Type-preserving closure conversion
% author: Olivier Savary-Belanger
% date: 2012-2013

%
% Types T
%
datatype tp: type =
| nat   : tp
| arr   : tp -> tp -> tp
| code  : tp -> tp -> tp
| cross : tp -> tp -> tp
| unit  : tp
;
%name tp T.





%
% Source language M,N
%
datatype source: tp -> type =
| lam  : (source T -> source S) -> source (arr T S)
| app  : source (arr T S) -> source T -> source S
| letv : source T -> (source T -> source S) -> source S
| z    : source nat
| suc  : source nat -> source nat
| nilv : source unit
| fst  : source (cross T S) -> source T
| rst  : source (cross T S) -> source S
| cons : source T -> source S -> source (cross T S)
;
%name source M.


%
% Target language P,Q
%
datatype target: tp -> type =
| cnil : target unit
| ccons : target T -> target S -> target (cross T S)
| cfst  : target (cross T S) -> target T
| crst  : target (cross T S) -> target S
| capp  : target (code T S) -> target T -> target S
| clam  : (target T -> target S) -> target (code T S)
| clet  : target T -> (target T -> target S) -> target S
% We write E for the type of the environment
| cpack : target  (code (cross T E) S) -> target E
       -> target (arr T S)
| copen : target (arr T S)
       -> ({e:tp} target (code (cross T e) S) -> target e -> target S)
       -> target S
| cz    : target nat
| csuc  : target nat -> target nat
;
%name target P.




schema ctx = source T;
schema tctx = target T;


datatype Ctx: {g:ctx} ctype =
| Ctx : {g:ctx} Ctx [g]
;


% SubCtx Γ' Γ ⇔ Γ' ⊆ Γ
datatype SubCtx: {g':ctx} {g:ctx} ctype =
| WInit: SubCtx [] []
| WDrop: SubCtx [g'] [g] -> SubCtx [g'] [g,x:source T]
| WKeep: SubCtx [g'] [g] -> SubCtx [g',x:source T] [g,x:source T]
;



datatype nat: type =
| nz : nat
| nsuc : nat -> nat
;

datatype wrap: tp -> nat -> type =
| ainit: (source T) -> wrap T nz
| add: (source S -> wrap T N) -> wrap (arr S T) (nsuc N)
;

% StrTerm [Γ] [ |- T] ⇔ ∃ Γ' M, Γ' ⊆ Γ ∧ and Γ' ⊢ M : T
datatype StrTerm: {g:ctx} [ |- tp] -> [ |- nat]  -> ctype =
| STm: [g' |-  wrap T N] -> SubCtx [g'] [g] -> StrTerm [g] [ |- T] [ |- N]
;

rec str: [g |- wrap T N] ->  StrTerm [g] [ |- T] [ |- N] =
fn e => case e of
| [ |- M] => STm [ |- M] WInit
| [g,x:source T |-  (M..)] =>
  let STm [h |- (M'..)] rel = str [g |- (M..)] in
    STm [h |- (M'..)] (WDrop rel)
| [g,x:source T |-  (M..x)] =>
  let  STm [h |- add (\x.M'..x)] rel = str [g |- add (\x. M..x)] in
    STm [h,x:source T |-  (M'..x)] (WKeep rel)
;


% Map Δ Γ ⇔ Δ ⊢ ρ : Γ
datatype Map:{h:tctx}{g:ctx} ctype =
| IdMap:{h:tctx} Map [h] []
| DotMap: Map [h] [g] -> [h |- target S] -> Map [h] [g,x:source S]
;

rec extendMap': Map [h] [g] -> Map [h,x:target S] [g] =
fn sigma => case sigma of
| IdMap [h] => IdMap [h,x:target _]
| DotMap sigma' [h |- M..] =>
  let rho' = extendMap' sigma' in
    DotMap rho' [h,x:target _ |-  (M..)]
;

rec extendMap: Map [h] [g] -> Map [h,x:target S] [g,x:source S] =
fn sigma => case sigma of
| IdMap [h]  => DotMap (IdMap [h,x:target _]) [h,x:target _ |-  x]
| DotMap sigma' [h |- M..] =>
  let rho' = extendMap' sigma' in
  let rho = DotMap rho' [h,x:target _ |-  M..] in
    DotMap rho [h,x:target _ |-  x]
;


rec pushMap: Map [x:target S] [g] -> Map [x:target (cross Y S)] [g] =
fn sigma => case sigma of
| IdMap [x:target S] => IdMap [x:target _]
| DotMap sigma' [x:target S |-  (M x)] =>
  let rho' = pushMap sigma' in
    DotMap rho' [x:target _  |-  (M (crst x))]
;


rec lookup: {#p:[g |- source T]} Map [h] [g] -> [h |- target T] =
mlam #p => fn sigma => let (sigma : Map [h] [g]) = sigma in case [g |- #p..] of
| [g',x:source T |-  x] =>
 let DotMap sigma' [h |- (M..)] = sigma in
  [h |- (M..)]
| [g',x:source S |-  #q..] =>
 let DotMap sigma' [h |- (M..)] = sigma in
  lookup [g' |-  #q..] sigma'
;




% The reified tuple is composed solely of variable
datatype VarTup: {g:ctx} [ |- tp] -> ctype =
| Emp : VarTup [] [ |- unit]
| Nex : VarTup [g] [ |- L] -> VarTup [g,x:source T] [ |- cross T L]
;

% CtxAsTup Γ ⇔ ∃ ρ, (x1,...,xn):(t1 × ... × tn) ⊢ ρ : Γ where Γ = x1:t1,...,xn:tn
datatype CtxAsTup: {g:ctx} ctype =
| CTup: VarTup [g] [ |- G] -> Map [x:target G] [g] -> CtxAsTup [g]
;


rec reify : Ctx [g] ->  CtxAsTup [g] =
fn g => case g of
| Ctx [ ] =>  CTup  Emp (IdMap [x:target unit])
| Ctx [g,x:source S] =>
  let  CTup vt sigma = reify (Ctx [g]) in
  let  rho' = pushMap sigma in
  let rho = DotMap rho' [xenv:target (cross S _) |-  cfst xenv] in
    CTup (Nex vt) rho
;

% replaces each variable contained in the VarTup by their respective target term from Map.
rec lookupVars: VarTup [g'] [ |- G] -> SubCtx [g'] [g] -> Map [h] [g] -> [h |- target G] =
fn vt => fn sub => fn sigma => let (sigma : Map [h] [g]) = sigma in case sub of
| WInit =>
  let Emp = vt in % g' = g = .
   [h |- cnil]
| WDrop sub' =>
  let DotMap sigma' [h |- P..] = sigma in
    lookupVars vt sub' sigma'
| WKeep sub' =>
  let (Nex vt')  = vt in
  let (DotMap sigma' [h |- P..]) = sigma in
  let [h |- M..] = lookupVars vt' sub' sigma' in
    [h |- ccons (P..) (M..)]
;



rec cc': Map [h] [g] -> [g |- source S] -> [h |- target S] =
fn sigma => fn e => let (sigma : Map [h] [g]) = sigma in case e of
| [g |- z] => [h |- cz]
| [g |- suc (M ..)] =>
  let [h |- (P'..)] = cc' sigma [g |- M..] in
  [h |- csuc (P'..)]
| [g |- #p..] => lookup [g |- #p..] sigma
| [g |- app (M..) (N..)] =>
  let [h |- (P..)] = cc' sigma [g |- M..] in
  let [h |- (Q..)] = cc' sigma [g |- N..] in
      [h |- copen (P..)
	 \e . \xf.\xenv. capp xf (ccons  (Q..) xenv)]
| [g |- letv (M..) (\x.(N..x))] =>
  let [h |- (P..)] = cc' sigma [g |- M..] in
  let [h,x:target S  |-  Q..x] =
     cc' (extendMap sigma)  [g,x |- N..x]
  in
    [h |- clet (P..) (\x.Q..x)]
| [g |- lam (\x.M..x)] =>
  let STm [g' |-  add (\x. ainit (M' .. x))] rel = str [g |- add (\x. ainit (M .. x))] in
  let CTup vt (rho:Map [xenv:target Tg] [g']) = reify (Ctx [g']) in
  let [h |- E..] = lookupVars vt rel sigma in
  let [xenv:target Tg,x:target S |-  (M'' xenv x)] = cc' (extendMap rho) [g',x:source _ |-  M'..x] in
    [h |- cpack  (clam (\clo. (clet (cfst clo) (\x.(clet (crst clo) (\xenv. M'' xenv x))))))   (E..)]
| [g |- cons (M..) (N..)] =>
  let [h |- M'..] = cc' sigma [g |- M..] in
  let [h |- N'..] = cc' sigma [g |- N..] in
    [h |- ccons (M'..) (N'..)]
| [g |- nilv] =>  [h |- cnil]
|[g |- fst (M..)] =>
 let [h |- M'..] =  cc' sigma [g |- M..] in
   [h |- cfst (M'..)]
|[g |- rst (M..)] =>
 let [h |- M'..] =  cc' sigma [g |- M..] in
   [h |- crst (M'..)]
;

rec cc: [ |- source T] -> [ |- target T] =
fn t => cc' (IdMap [])  t
;



% Examples, run with -implicit flag

let t0 = cc [ |- app (lam (\x.x)) z ];
let t1 = cc [ |- app (lam (\x.(app (lam (\y.y)) x))) z];
let t2 = cc [ |- app (app (app (lam \x. (lam \y. (lam \w . x))) z) z) z];
