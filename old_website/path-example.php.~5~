<p> The inductive proof can be implemented as a recursive function in Beluga following
closely the more informal development given earlier. We treat computation-level expressions
which correspond to quantifier introduction and elimination differently from the expressions
corresponding to implication introduction and elimination. To introduce a universally
quantified meta-variable <codeinline>P</codeinline>, we write
<codeinline><keyword>mlam</keyword> P &rArr; ...</codeinline>. To eliminate a universal
quantifier, we write <codeinline>e &lt;g.M&gt;</codeinline>  where <codeinline>e</codeinline>
has type <codeinline>{M::A[g]}.tau</codeinline> and <codeinline>g.M</codeinline>
describes the data-level object used to instantiate the universal quantifier and has
type <codeinline>A</codeinline> in the context <codeinline>g</codeinline>. For implication
introduction, we write <codeinline><keyword>fn</keyword> x &rArr; ...</codeinline>
</p>
<pre class="code">
<keyword>rec</keyword> eqPath : {g:(ctx)*}{M::exp[g]}{N::exp[g]}
             ({P::path[g]} (is_path (P <i>..</i>) (M <i>..</i>))[g] &rarr; (is_path (P <i>..</i>) (N <i>..</i>))[g])
	    &rarr; (eq (M <i>..</i>) (N <i>..</i>))[g] = 
<keyword>&Lambda;</keyword> g &rArr; <keyword>mlam</keyword> M &rArr; <keyword>mlam</keyword> N &rArr; <keyword>fn</keyword> f &rArr; <keyword>case</keyword> [g] M <i>..</i> <keyword>of</keyword>
 | [g] app (M1 <i>..</i>) (M2 <i>..</i>)  &rArr; 
    <keyword>let</keyword> [g] p_left p_done : (is_path (left done) (app (N1 <i>..</i>) (N2 <i>..</i>)))[g] 
       = f &lt;g. (left done) &gt; ([g] p_left p_done) <keyword>in</keyword> 

   <keyword>let</keyword> [g] e_ref = 
     eqPath [g] &lt;g. M2 <i>..</i> &gt; &lt;g. (N2 <i>..</i>)  &gt; 
     (<keyword>mlam</keyword> Q &rArr; <keyword>fn</keyword> iq &rArr; <keyword>let</keyword> [g] D <i>..</i> = iq <keyword>in</keyword> 
      <keyword>let</keyword> [g] p_right (D' <i>..</i>) : (is_path (right (Q' <i>..</i> )) (app (N1 <i>..</i>) (N2 <i>..</i>)))[g] =
        f &lt; g. (right (Q <i>..</i>)) &gt; ([g] p_right (D <i>..</i> )) 
       <keyword>in</keyword> [g] D' <i>..</i>   )  <keyword>in</keyword>

   <keyword>let</keyword> [g] e_ref  = 
      eqPath [g] &lt;g. M1 <i>..</i> &gt; &lt;g. (N1 <i>..</i>) &gt;
      (<keyword>mlam</keyword> Q &rArr; <keyword>fn</keyword> iq &rArr; 
       <keyword>let</keyword> [g] D <i>..</i> = iq <keyword>in</keyword> 
       <keyword>let</keyword> [g] p_left (D' <i>..</i>) : (is_path (left (Q' <i>..</i> )) (app (N1 <i>..</i>) (N2 <i>..</i>)))[g] =
         f &lt; g. (left (Q <i>..</i>)) &gt; ([g] p_left (D <i>..</i> )) 
       <keyword>in</keyword> [g] D' <i>..</i>   )                           
    <keyword>in</keyword>  		 
     [g] e_ref

| [g] #p.1 <i>..</i> &rArr; 
  <keyword>let</keyword> [g] #q.3 <i>..</i> = f &lt;g. #p.2 <i>..</i> &gt; ([g] #p.3 <i>..</i> ) <keyword>in</keyword> 
    [g] e_ref


| [g] lam T (\x. M' <i>..</i> x) &rArr; 
  <keyword>let</keyword>  [g] p_lam (\x.\p. \i. p_done)  : 
       (is_path (bind T' (\p.done)) (lam _ (\x. N' <i>..</i> x)))[g]  = 
       f &lt;g. bind T (\p.done) &gt; ([g] p_lam (\x.\p.\i. p_done)) <keyword>in</keyword> 

  <keyword>let</keyword> [g,b:block x:exp, q:path . is_path q x] e_ref = 
     eqPath [g, b:block x:exp, q:path . is_path q x] 
     &lt;g,b. M' <i>..</i> b.1 &gt; &lt;g,b. N' <i>..</i> b.1 &gt; 
     (<keyword>mlam</keyword> Q &rArr; <keyword>fn</keyword> ip &rArr;
      <keyword>let</keyword> [g,b:block x:exp, q:path. is_path q x] Qs <i>..</i> b.2 = 
          [g,b:block x:exp, q:path. is_path q x] Q <i>..</i> b <keyword>in</keyword>           <comment>% strengthening </comment>
      <keyword>let</keyword> [g,b:block x:exp, q:path. is_path q x] D <i>..</i> b = ip <keyword>in</keyword> 
      <keyword>let</keyword> [g] p_lam (\x.\q.\iq. D' <i>..</i> x q iq) : 
          (is_path (bind _ (\q. Q' <i>..</i> q)) (lam _ (\x. N' <i>..</i> x)))[g] =  
           f &lt; g. bind T (\q. Qs <i>..</i> q) &gt;  ([g] p_lam (\x.\q.\iq. D <i>..</i> &lt;x,q,iq&gt; )  ) 
      <keyword>in</keyword>
         [g,b] D' <i>..</i> b.1 b.2 b.3
       )
  <keyword>in</keyword> 
    [g] e_ref
;

<keyword>rec</keyword> path_thm : {M::exp[ ]}{N::exp[ ]}
               ({P::path[ ]}(is_path P M)[ ] &rarr; (is_path P N)[ ])
	     &rarr; (eq M N)[ ] = 
<keyword>mlam</keyword> M &rArr; <keyword>mlam</keyword> N &rArr; <keyword>fn</keyword> f &rArr; eqPath [ ] &lt; . M &gt; &lt; . N &gt;  f ;
</pre>

