% Definition of types and expressions
tp: type.  %name tp T a.
arr: tp -> tp -> tp.
nat: tp.

exp: type. %name exp M x.
lam : tp -> (exp -> exp) -> exp.
app : exp -> exp -> exp.

% Typing judgment
type_of: exp -> tp -> type. %name type_of D u.

t_lam: ({x:exp}type_of x T1 -> type_of (E x) T2)
	-> type_of (lam T1 E) (arr T1 T2).
	  
t_app: type_of E1 (arr T2 T) -> type_of E2 T2
       -> type_of (app E1 E2) T.


% Equality predicate


% Equality predicate
equal: tp -> tp -> type. %name equal E e.
e_nat: equal nat nat.
e_arr:  equal T1 S1 -> equal T2 S2
	-> equal (arr T1 T2) (arr S1 S2).

ref: {T}equal T T -> type.
%mode ref +T -D.
r_nat: ref nat e_nat.
r_arr: ref (arr T1 T2) (e_arr D1 D2)
	<- ref T1 D1
	<- ref T2 D2.


%worlds ( ) (ref T D).
%covers ref +T -D.
%total T (ref T D).

unique : type_of E T -> type_of E T' -> equal T T' -> type. 
%mode unique +D +F -E.
u_lam: unique (t_lam D) (t_lam F) (e_arr E1 E2)
	<- ref T1 E1
	<- ({x}{u:type_of x T1}
            unique u u E1 -> unique (D x u) (F x u) E2).

u_app: unique (t_app D1 D2) (t_app F1 F2) E2
	<- unique D1 F1 (e_arr E1 E2).


%block l : some {T:tp}{E1:equal T T} block {x:exp}{u:type_of x T}{e:unique u u E1}.
%worlds (l) (unique D F E).

%covers unique +D +F -E.
%terminates D (unique D F E).
%total D (unique D F E).
